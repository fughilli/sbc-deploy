# sbc-deploy Bazel configuration.

# The bundled JDK SIGILLs on Armv9 SVE (Apple-silicon hosts running the
# aarch64 container); disable SVE and tolerate the flag on hosts without it.
startup --host_jvm_args=-XX:+IgnoreUnrecognizedVMOptions
startup --host_jvm_args=-XX:UseSVE=0

common --enable_bzlmod
common --registry=https://bcr.bazel.build

# Enables `isolate = True` on the rules_nixpkgs extension usages (MODULE.bazel),
# required so `.attr`/`.github` are legal when sbc-deploy is a dependency module.
common --experimental_isolated_extension_usages

# Deterministic action environment.
build --incompatible_strict_action_env

# Keep caches inside the tree (gitignored) so they survive container rebuilds.
build --disk_cache=.bazel-disk-cache
common --repository_cache=.bazel-repo-cache

build --symlink_prefix=bazel-
common --color=yes
common --show_timestamps
