"""sbc-deploy — a reusable Bazel + Nix module for deploying packaged
applications to single-board computers (Raspberry Pi and friends).

The runnable deploy targets are shell wrappers that shell out to the `nix` /
`nixos-rebuild` CLIs. `nix` (with flakes) is a SYSTEM REQUIREMENT for the module
in any case, so we lean into it: the deploy scripts run under a hermetic,
nixpkgs-vendored bash (rules_nixpkgs imports it as `@nixpkgs_bash`), not the
host's system bash — which on macOS is the ancient 3.2. A small runfiles-aware
launcher execs that bash on the real script.

Consumers depend on this module and call the `sbc_deploy` macro from
`@sbc_deploy//deploy:defs.bzl`; on the Nix side they add this repo as a flake
input and call `sbc-deploy.lib.mkSbcSystem`.
"""

module(
    name = "sbc_deploy",
    version = "0.0.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_shell", version = "0.4.0")

# ---------------------------------------------------------------------------
# Hermetic bash from nixpkgs.
#
# sh_binary uses the script's shebang for its interpreter, so on macOS it would
# otherwise run under /bin/bash 3.2. We instead vendor bash from a pinned
# nixpkgs snapshot and exec the deploy script under it (see deploy/defs.bzl +
# deploy/scripts/launch.sh). Repository fetches stay lazy — the bash package is
# realized only when a deploy target is built/run.
# ---------------------------------------------------------------------------
bazel_dep(name = "rules_nixpkgs_core", version = "0.13.0")

nix_repo = use_extension("@rules_nixpkgs_core//extensions:repository.bzl", "nix_repo")
nix_repo.github(
    name = "nixpkgs",
    org = "NixOS",
    repo = "nixpkgs",
    tag = "25.05",
    sha256 = "130b4257b3d53bfbfea6d61fb76d4751a3989a4a09a28615ff77516a82b3924d",
)
use_repo(nix_repo, "nixpkgs")

nix_pkg = use_extension("@rules_nixpkgs_core//extensions:package.bzl", "nix_pkg")
nix_pkg.attr(
    name = "nixpkgs_bash",
    attr = "bash",
    build_file_content = """\
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "bash",
    srcs = ["bin/bash"],
)
""",
    repo = "@nixpkgs",
)
use_repo(nix_pkg, "nixpkgs_bash")

# yj — a tiny static Go binary that converts YAML/TOML/HCL <-> JSON. Used by the
# `wifi_config_file` path of the sbc_application macro to convert a declarative
# WiFi YAML into JSON at build time, so Nix reads it with the native fromJSON
# (no YAML parser or import-from-derivation needed on the Nix side).
nix_pkg.attr(
    name = "nixpkgs_yj",
    attr = "yj",
    build_file_content = """\
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "yj",
    srcs = ["bin/yj"],
)
""",
    repo = "@nixpkgs",
)
use_repo(nix_pkg, "nixpkgs_yj")

# zstd — decompress the .img.zst SD image on the fly when flashing, so the
# `image_sd --device …` target is turnkey (no system zstd needed).
nix_pkg.attr(
    name = "nixpkgs_zstd",
    attr = "zstd",
    build_file_content = """\
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "zstd",
    srcs = ["bin/zstd"],
)
""",
    repo = "@nixpkgs",
)
use_repo(nix_pkg, "nixpkgs_zstd")

# pv — pipe-viewer, for a progress bar/ETA while writing the image to the card.
nix_pkg.attr(
    name = "nixpkgs_pv",
    attr = "pv",
    build_file_content = """\
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "pv",
    srcs = ["bin/pv"],
)
""",
    repo = "@nixpkgs",
)
use_repo(nix_pkg, "nixpkgs_pv")

# nixos-rebuild — the live-deploy target shells out to it; it's a NixOS tool not
# present on a stock macOS/Determinate install, so vendor it (it evaluates and
# builds for darwin, and supports remote --target-host deploys).
nix_pkg.attr(
    name = "nixpkgs_nixos_rebuild",
    attr = "nixos-rebuild",
    build_file_content = """\
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "nixos-rebuild",
    srcs = ["bin/nixos-rebuild"],
)
""",
    repo = "@nixpkgs",
)
use_repo(nix_pkg, "nixpkgs_nixos_rebuild")
