# hello-sbc example — demonstrates the sbc_application macro and its three
# deployment modes.
#
#   bazel run //examples/hello-sbc:hello.keys          -- init
#   bazel run //examples/hello-sbc:hello.image_sd      -- --no-write   # base + app
#   bazel run //examples/hello-sbc:hello.image_sd_base -- --no-write   # base only
#   bazel run //examples/hello-sbc:hello.deploy_live   -- hello.local  # push app

load("@sbc_deploy//deploy:defs.bzl", "sbc_application")

sbc_application(
    name = "hello",
    flake = "examples/hello-sbc/nix",
    hostname = "hello",
    # sbc-deploy's own framework lives in this same repo at //nix, so inject it:
    # the targets build against the in-tree framework (no `nix flake update`).
    framework = "nix",
    # Declarative WiFi: a YAML list of networks (placeholder creds here). Swap in
    # real values, or drop this arg and use inline sbcDeploy.wifi / env vars.
    wifi_config_file = "wifi.yaml",
)
