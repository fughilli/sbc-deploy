# hello-amd64 example — the amd64 (x86_64) counterpart of hello-sbc. Builds a
# bootable install USB that installs the system onto an amd64 mini PC's internal
# disk, then supports live redeploys just like the Pi path.
#
#   bazel run //examples/hello-amd64:hello.keys              -- init
#   bazel run //examples/hello-amd64:hello.image_installer   -- --no-write        # build the install USB
#   bazel run //examples/hello-amd64:hello.image_installer   -- --device /dev/sdX # write it to a USB stick
#   bazel run //examples/hello-amd64:hello.deploy_live       -- hello-amd64.local # push the app to a booted box

load("@sbc_deploy//deploy:defs.bzl", "sbc_application")

sbc_application(
    name = "hello",
    flake = "examples/hello-amd64/nix",
    hostname = "hello-amd64",
    # amd64 mini PC: UEFI + systemd-boot, no board-specific kernel/firmware. The
    # "x86_64" family swaps the system builder to stock nixpkgs and makes the
    # image_installer target build a bootable install USB.
    board = "@sbc_deploy//deploy/boards:amd64-generic",
    # sbc-deploy's own framework lives in this same repo at //nix, so inject it:
    # the targets build against the in-tree framework (no `nix flake update`).
    framework = "nix",
    # Declarative WiFi: a YAML list of networks, converted to JSON at build time
    # and baked into the image so the box joins on first boot (needed to reach it
    # for deploy_live over WiFi). Copy wifi.yaml.example -> wifi.yaml (gitignored)
    # and fill in real credentials.
    wifi_config_file = "wifi.yaml",
)
