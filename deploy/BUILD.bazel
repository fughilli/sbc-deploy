# The generic deploy entrypoint, consumed by the sbc_deploy macro (defs.bzl).
package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "boards.bzl",
])

exports_files(
    glob(["scripts/*.sh"]),
)

# Runnable seeder so consumers can `bazel run @sbc_deploy//deploy:seed_wifi -- …`
# to add persistent WiFi networks to a running board without a rebuild.
sh_binary(
    name = "seed_wifi",
    srcs = ["scripts/seed_wifi.sh"],
)

# Offline sibling: add WiFi profiles to an ALREADY-IMAGED SD card (no boot, no
# rebuild) via e2fsprogs' debugfs. The leading arg is debugfs's runfiles path.
#   bazel run @sbc_deploy//deploy:sd_seed_wifi -- --device /dev/sdX --ssid S --psk P
sh_binary(
    name = "sd_seed_wifi",
    srcs = ["scripts/sd_seed_wifi.sh"],
    args = ["$(rlocationpath @nixpkgs_e2fsprogs//:debugfs)"],
    data = [
        "@bazel_tools//tools/bash/runfiles",
        "@nixpkgs_e2fsprogs//:debugfs",
    ],
)
