# Predefined board definitions for sbc_application's `board = ` attribute.
# Reference as @sbc_deploy//deploy/boards:raspberry-pi-N. Define your own with
# the sbc_board rule (load "@sbc_deploy//deploy:boards.bzl").
load("//deploy:boards.bzl", "sbc_board")

package(default_visibility = ["//visibility:public"])

# display-vc4 (HDMI / VC4-KMS console) is available on the Pi 5/4/02 and useful
# for on-a-monitor commissioning; the Pi 3 ships only `base` upstream.
sbc_board(
    name = "raspberry-pi-5",
    nixos_board = "raspberry-pi-5",
    modules = ["display-vc4"],
)

sbc_board(
    name = "raspberry-pi-4",
    nixos_board = "raspberry-pi-4",
    modules = ["display-vc4"],
)

sbc_board(
    name = "raspberry-pi-3",
    nixos_board = "raspberry-pi-3",
)

sbc_board(
    name = "raspberry-pi-02",
    nixos_board = "raspberry-pi-02",
    modules = ["display-vc4"],
)

# The Pi Zero 2 W IS raspberry-pi-02 upstream (bcm2710a1 / Cortex-A53, the rpi02
# kernel) — a discoverable alias by its marketing name. NB: the original Pi Zero W
# (v1, BCM2835 / ARM11, armv6l) has NO board here — nixos-raspberrypi is aarch64-only
# and exposes only pi-02/3/4/5, and mainline NixOS dropped armv6, so it can't build.
alias(
    name = "raspberry-pi-zero-2w",
    actual = ":raspberry-pi-02",
)
